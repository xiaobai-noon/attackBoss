{
  "version": 1,
  "_comment": "《打boss》镜头表（Shot Table）。一个「镜头」= 一组分层图 + 一段相机运动。剧本用 shot 节点引用镜头 id。",
  "design_size": [1280, 720],
  "source_size": [2560, 1440],
  "_source_size_note": "素材出图为设计分辨率的 2 倍，引擎侧才能从同一张图裁出不同景别（近/中/特写）。低于 2K，近景裁切会糊。",

  "scope": {
    "_comment": "范围标记。alpha 是当前唯一在做的范围（见 docs/α切片范围.md）；不在 alpha 列表里的场景属于预留，alpha 阶段不生成任何图。",
    "alpha": {
      "name": "α 垂直切片",
      "scenes": ["meeting_room", "office_floor", "pantry"],
      "events": ["weekly_report_inflation", "credit_dispute", "pantry_rumor_version"],
      "ending": "quit_clear",
      "note": "3 场景 / 3 事件 / 1 结局 / 约 14 分钟。事件与结局 id 对应 data/events.json 与 docs/职级轮回_游戏策划书.md 第 7/8 章。"
    },
    "reserved": {
      "scenes": ["night_office"],
      "note": "结局段落与 β / 1.0 使用，α 不做。"
    }
  },

  "_motion_model": {
    "zoom": "[起点, 终点] 推拉倍率。必须 ≥ 1.02（<1 会露边，=1 会除零）。",
    "focus": "[x, y] 缩放锚点（0~1，画面不动的那一点）。常量，不随时间变。",
    "pan": "[[x0,y0],[x1,y1]] 相机位移，单位＝屏宽/屏高的倍数。0.05 = 移动 5% 屏宽。",
    "constraint": "|pan| × max深度 ≤ (zoom-1)/2，否则推拉平移会把图片边缘露出来。校验脚本会拦。",
    "depth": "视差系数。各层实际位移 = pan × depth。近处动得多 → 有纵深。"
  },
  "moves": {
    "in": "推近（缓）—— 注意力收拢、进入情绪",
    "out": "拉远（缓）—— 抽离、收束、留白",
    "pan_l": "左移 —— 扫视环境、暗示他人反应",
    "pan_r": "右移",
    "tilt_u": "上摇 —— 权威感、抬头看",
    "tilt_d": "下摇 —— 压迫感、低头看",
    "hold": "定镜微呼吸 —— 什么都不发生时用它。禁止全静止，那会看起来像 PPT。",
    "push_shake": "推近 + 轻微震动 —— 冲击、坏消息落地"
  },

  "depth": {
    "far": 0.22,
    "mid": 0.50,
    "near": 0.80,
    "over": 1.00
  },

